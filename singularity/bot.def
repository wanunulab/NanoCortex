Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%post
    # --- 1. 更新系统并安装基础构建工具 ---
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        wget curl bzip2 ca-certificates git build-essential \
        zlib1g-dev libbz2-dev liblzma-dev libncurses5-dev libxml2-dev \
        software-properties-common dirmngr gnupg lsb-release cmake \
        libcurl4-openssl-dev libssl-dev libfontconfig1-dev \
        libharfbuzz-dev libfribidi-dev libfreetype6-dev \
        libpng-dev libtiff5-dev libjpeg-dev
    
    # --- 2. 安装 R 4.3+ (从 CRAN 源) ---
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
    apt-get update && apt-get install -y r-base r-base-dev

    # --- 3. 安装常用生信工具 (系统级) ---
    apt-get install -y samtools minimap2 bedtools
    apt-get clean

    # --- 4. 安装 Miniforge (Conda/Mamba) ---
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /miniforge.sh
    bash /miniforge.sh -b -p /opt/conda
    rm /miniforge.sh
    export PATH="/opt/conda/bin:$PATH"

    # --- 5. 配置 Conda 环境 ---
    
    # 环境 A: Remora
    mamba create -y -n remora_env python=3.9
    /opt/conda/envs/remora_env/bin/pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121
    /opt/conda/envs/remora_env/bin/pip install ont-remora

    # 环境 B: RNA-FM (包含科学计算全家桶)
    mamba create -y -n RNA_FM python=3.9
    /opt/conda/bin/mamba install -n RNA_FM -c pytorch -c nvidia -y \
        pytorch torchvision pytorch-cuda=11.8 \
        numpy pandas matplotlib scikit-learn biopython tqdm
    /opt/conda/envs/RNA_FM/bin/pip install rna-fm

    # 环境 C: Flair
    mamba create -y -n flair -c conda-forge -c bioconda flair

    # --- 6. 安装 R 绘图及 Motif 相关包 ---
    # 预装 ggplot2, ggseqlogo (Motif画图), universalmotif (Bioconductor)
    R -e "options(Ncpus = 8); install.packages(c('ggplot2', 'dplyr', 'ggseqlogo', 'BiocManager'), repos='https://cloud.r-project.org/')"
    R -e "BiocManager::install(c('universalmotif', 'motifStack'), ask=FALSE)"

    # --- 7. 安装 Dorado (v1.4.0) ---
    cd /opt
    wget https://cdn.oxfordnanoportal.com/software/analysis/dorado-1.4.0-linux-x64.tar.gz
    tar -xzf dorado-1.4.0-linux-x64.tar.gz && rm dorado-1.4.0-linux-x64.tar.gz
    ln -s /opt/dorado-1.4.0-linux-x64/bin/dorado /usr/local/bin/dorado

    # --- 8. 安装 Modkit (v0.6.1) ---
    cd /opt
    wget https://github.com/nanoporetech/modkit/releases/download/v0.6.1/modkit_v0.6.1_u16_x86_64.tar.gz
    tar -xzf modkit_v0.6.1_u16_x86_64.tar.gz && rm modkit_v0.6.1_u16_x86_64.tar.gz
    # 注意解压后的文件夹名
    mv dist_modkit_v0.6.1_481e3c9/modkit /usr/local/bin/modkit
    chmod +x /usr/local/bin/modkit

    # --- 9. 编译 StringTie ---
    cd /opt
    git clone https://github.com/gpertea/stringtie
    cd stringtie && make release
    ln -s /opt/stringtie/stringtie /usr/local/bin/stringtie

    # 清理缓存
    conda clean -afy
    apt-get autoremove -y

%environment
    # 设置环境变量，确保运行时能找到所有工具
    export PATH="/opt/conda/bin:/opt/dorado-1.4.0-linux-x64/bin:/usr/local/bin:$PATH"
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    # 防止 R 画图时因为没有显示器而报错
    export R_OPTS="--no-save --no-restore"

%runscript
    echo "==========================================================="
    echo "  Container 'bot.sif' is ready for Nanopore & RNA Analysis"
    echo "==========================================================="
    echo "  Installed Tools: dorado, modkit, samtools, minimap2, bedtools, stringtie, R (w/ ggplot2 & universalmotif)"
    echo "  Conda Envs: remora_env, RNA_FM, flair"
    echo "==========================================================="

%test
    # 验证关键工具是否存在
    dorado --version
    samtools --version
    R --version
    # 验证 R 包是否安装成功
    R -e "library(ggseqlogo); library(universalmotif); message('R packages loaded OK')"